# 이 파일을 .env.local로 복사해서 사용하세요. (.env.local은 git에 올라가지 않습니다)

# 개발 서버(npm run dev)가 /api 요청을 넘길 백엔드 주소
API_PROXY_TARGET=https://pico-dev.duckdns.org
# 로컬 백엔드에 붙일 때: API_PROXY_TARGET=http://localhost:8080

# 배포·앱 빌드에서 API를 다른 도메인으로 호출할 때만 설정 (비우면 같은 출처)
# VITE_API_BASE_URL=https://api.example.com

# [임시] 백엔드에 약관(GET /api/policies)이 없을 때 쓸 약관 문서 번호(회원가입, 요청·수락의 연락처 공유 동의). 약관이 등록되면 지우세요.
# VITE_FALLBACK_TERMS_ID=1
# VITE_FALLBACK_PRIVACY_ID=2
# VITE_FALLBACK_CONTACT_SHARING_ID=3
